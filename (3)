#include "opencv2/opencv.hpp"
#include <iostream>

using namespace cv;
using namespace std;

int main() {
    // 1. 원본 사진(src)을 깨끗하게 불러옵니다 (이 상자는 절대 안 건드려요!)
    Mat src = imread("lenna.bmp");
    if (src.empty()) {
        cerr << "사진을 찾을 수 없어요! 파일 이름이나 경로를 확인하세요." << endl;
        return -1;
    }

    // 사진의 정중앙 점을 회전 중심으로 잡아요
    Point2f center = Point2f(src.cols / 2.0f, src.rows / 2.0f);

    double total_angle = 0; // 누적된 총 회전 각도를 저장할 상자

    // 처음 원본 상태를 보여줍니다
    imshow("src", src);

    // 2. 무한히 반복하면서 키보드 입력을 감시합니다
    while (true) {
        // [중요] 원본(src)에서 여태까지 쌓인 total_angle만큼 한 번에 돌릴 지도를 만듭니다
        Mat M = getRotationMatrix2D(center, total_angle, 1.0);

        Mat dst;
        warpAffine(src, dst, M, src.size());

        // 회전된 멋진 결과를 화면에 보여줍니다
        imshow("dst", dst);

        // ?? [응답 없음 에러 해결] 30밀리초 동안 키 입력을 기다리며 화면을 새로고침합니다
        int key = waitKey(30);

        // 3. 사용자가 어떤 키를 눌렀는지 검사합니다
        if (key == 'r' || key == 'R') {
            // r 키를 누르면 시계 방향으로 10도 회전 (마이너스)
            total_angle -= 10;
        }
        else if (key == 'b' || key == 'B') {
            // b 키를 누르면 반시계 방향으로 10도 회전 (플러스)
            total_angle += 10;
        }
        else if (key == 'q' || key == 'Q' || key == 27) {
            // q나 ESC(27)를 누르면 프로그램 완전히 종료!
            break;
        }
    }

    return 0;
}
